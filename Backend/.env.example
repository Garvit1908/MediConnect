# ====================================================
# MediConnect Backend Production Environment Variables
# ====================================================

# Port the Express server listens on (Container default is 4000)
PORT=4000

# Environment: "development" or "production"
NODE_ENV=production

# MongoDB Connection String (Atlas or Docker service)
# For local docker-compose use: mongodb://mongo:27017/mediconnect
# For Atlas use: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mediconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mediconnect?retryWrites=true&w=majority

# Client frontend URL for CORS origin whitelisting in production
CLIENT_URL=http://localhost:5173
# Set to true only when a single trusted reverse proxy is in front of the API.
TRUST_PROXY=false
# Keep lax for same-site deployments; use none only with HTTPS cross-site cookies.
COOKIE_SAMESITE=lax

# Email Service (Resend - HTTP API)
# Get a free API key at https://resend.com (3,000 free emails/month)
RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM="MediConnect <no-reply@mediconnecthealth.me>"

# JWT Authentication Secrets (Generate strong random 64-character hex strings in production)
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=15d

# Cloudinary Storage Configuration
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway (Test or Live credentials)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Google OAuth 2.0 Credentials (Google Cloud Console Web Client ID)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Redis Cache Configuration (Optional - app gracefully degrades if absent)
# For local Docker: redis://127.0.0.1:6379
# For Upstash / Redis Cloud: rediss://default:password@cluster.upstash.io:6379
REDIS_URI=redis://127.0.0.1:6379

# Primary Administrator Credentials (Auto-seeded on server startup)
ADMIN_EMAIL=johncen.8091@gmail.com
ADMIN_PASSWORD=Admin@123

