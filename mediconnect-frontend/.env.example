# Not read by Vite at runtime — this only documents BACKEND_URL, which the
# proxy in vite.config.js reads directly from the shell/OS environment.
# Example: BACKEND_URL=http://localhost:4000 npm run dev
BACKEND_URL=http://localhost:4000

# Google OAuth 2.0 Client ID (from Google Cloud Console -> Credentials)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Optional: Override API base URL in production if different from current origin / Render fallback
# VITE_API_BASE_URL=https://your-backend-api.com

# WebRTC Metered TURN Configuration (Optional: defaults to free OpenRelay STUN/TURN servers)
# Sign up at https://www.metered.ca/ or use your created app name and API key
VITE_METERED_APP_NAME=mediconnecthealth
VITE_METERED_API_KEY=your_metered_api_key_here
